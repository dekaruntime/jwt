import { Result } from 'core/result'

/// docid: phpx/jwt/sign()
/// <Function name="sign">
///   <Description>PHPX standard module function `sign` from `jwt`.</Description>
///   <Parameter name="$payload" type="mixed" required="true" typeLink="/docs/php/types/mixed">
///     Parameter $payload.
///   </Parameter>
///   <Parameter name="$secret" type="mixed" required="true" typeLink="/docs/php/types/mixed">
///     Parameter $secret.
///   </Parameter>
///   <Parameter name="$options" type="mixed" required="false" typeLink="/docs/php/types/mixed">
///     Parameter $options.
///   </Parameter>
///   <ReturnType type="Result<string, string>" />
/// </Function>
export function sign($payload: mixed, $secret: mixed, $options: mixed = []): Result<string, string>

/// docid: phpx/jwt/verify()
/// <Function name="verify">
///   <Description>PHPX standard module function `verify` from `jwt`.</Description>
