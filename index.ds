// Compact JWS on @deka/crypto. HS256 only; alg=none is rejected.
import { hmac, secure_compare } from "@deka/crypto"
import { from_string, to_string, to_base64, from_base64 } from "@deka/bytes"

interface JwtClaims {
  iat?: number;
  exp?: number;
  nbf?: number;
  iss?: string;
  aud?: string;
  sub?: string;
}

interface JwtOptions {
  alg?: string;
  iss?: string;
  aud?: string;
  sub?: string;
  exp_in?: number;
  exp?: number;
  leeway?: number;
}

interface JwtHeader { alg?: string }
interface JwtParts { header: string; payload: string; signature: string; input: string }

summon {
  parse_header_json(json: string): Exception<JwtHeader, JsError>,
  parse_claims_json(json: string): Exception<JwtClaims, JsError>,
  serialize_claims(payload: JwtClaims, iat: number, exp: Option<number>, iss: Option<string>, aud: Option<string>, sub: Option<string>): Exception<string, JsError>,
  total now_seconds(): number,
  total valid_b64url(value: string): boolean
} from "./boundary.mjs"

fn b64url_encode(data: bytes) string {
  return to_base64(data).split("+").join("-").split("/").join("_").split("=").join("")
}

fn b64url_decode(value: string) Exception<bytes, JsError> {
  return from_base64(value.split("-").join("+").split("_").join("/"))
}

fn option_alg(options: JwtOptions) string {
  const alg = match (options.alg) { Some(v) => v, None => "HS256" }
  if (alg == "") { return "HS256" }
  return alg.toUpperCase()
}

fn claims_json(payload: JwtClaims, options: JwtOptions) Exception<string, JsError> {
  const now = now_seconds()
  const iat = match (payload.iat) { Some(v) => v, None => now }
  const relative_exp = match (options.exp_in) { Some(v) => Some(now + v), None => payload.exp }
  const exp = match (options.exp) { Some(v) => Some(v), None => relative_exp }
  return serialize_claims(payload, iat, exp, options.iss, options.aud, options.sub)
}

fn jwt_parts(token: string) Result<JwtParts, string> {
  const p = token.split(".")
  if (p.length != 3) { return Err("invalid jwt format") }
  let header = ""
  let payload = ""
  let signature = ""
  let index = 0
  for (const part of p) {
    if (!valid_b64url(part)) { return Err("invalid jwt format") }
    if (index == 0) { header = part }
    if (index == 1) { payload = part }
    if (index == 2) { signature = part }
    index = index + 1
  }
  return Ok({ header: header, payload: payload, signature: signature, input: header + "." + payload })
}

fn header_alg(header_b64: string) Exception<string, JsError> {
  return match (b64url_decode(header_b64)) {
    Throw(e) => Throw(e),
    Ok(raw) => match (parse_header_json(to_string(raw))) {
      Throw(e) => Throw(e),
      Ok(header) => Ok(match (header.alg) { Some(v) => v, None => "" })
    }
  }
}

fn parse_claims(payload_b64: string) Exception<JwtClaims, JsError> {
  return match (b64url_decode(payload_b64)) {
    Throw(e) => Throw(e),
    Ok(raw) => match (parse_claims_json(to_string(raw))) { Ok(claims) => Ok(claims), Throw(e) => Throw(e) }
  }
}

fn string_or_empty(value: Option<string>) string {
  return match (value) { Some(v) => v, None => "" }
}

fn validate_claims(claims: JwtClaims, options: JwtOptions) Result<boolean, string> {
  const now = now_seconds()
  const leeway = match (options.leeway) { Some(v) => v, None => 0 }
  const future = match (claims.iat) { Some(v) => v - leeway > now, None => false }
  if (future) { return Err("jwt issued in future") }
  const expired = match (claims.exp) { Some(v) => v + leeway < now, None => false }
  if (expired) { return Err("jwt expired") }
  const inactive = match (claims.nbf) { Some(v) => v - leeway > now, None => false }
  if (inactive) { return Err("jwt not active yet") }
  const wrong_issuer = match (options.iss) { Some(v) => string_or_empty(claims.iss) != v, None => false }
  if (wrong_issuer) { return Err("jwt issuer mismatch") }
  const wrong_audience = match (options.aud) { Some(v) => string_or_empty(claims.aud) != v, None => false }
  if (wrong_audience) { return Err("jwt audience mismatch") }
  return Ok(true)
}

fn sign_json(json: string, secret: bytes) Result<string, string> {
  const input = b64url_encode(from_string("{\"alg\":\"HS256\",\"typ\":\"JWT\"}")) + "." + b64url_encode(from_string(json))
  return match (hmac("sha256", secret, from_string(input))) {
    Ok(sig) => Ok(input + "." + b64url_encode(sig)),
    Err(e) => Err(e)
  }
}

export fn sign(payload: JwtClaims, secret: bytes, options: JwtOptions = {}) Result<string, string> {
  if (option_alg(options) != "HS256") { return Err("unsupported jwt alg") }
  return match (claims_json(payload, options)) {
    Throw(e) => Err("failed to encode jwt payload"),
    Ok(json) => sign_json(json, secret)
  }
}

fn verified_claims(payload: string, options: JwtOptions) Result<JwtClaims, string> {
  return match (parse_claims(payload)) {
    Throw(e) => Err("invalid jwt payload"),
    Ok(claims) => match (validate_claims(claims, options)) {
      Err(e) => Err(e),
      Ok(_) => Ok(claims)
    }
  }
}

fn verify_signature(p: JwtParts, secret: bytes, options: JwtOptions) Result<JwtClaims, string> {
  return match (hmac("sha256", secret, from_string(p.input))) {
    Err(e) => Err(e),
    Ok(expected) => match (b64url_decode(p.signature)) {
      Throw(e) => Err("invalid jwt signature"),
      Ok(signature) => match (secure_compare(expected, signature)) {
        Err(e) => Err(e),
        Ok(eq) => eq == true ? verified_claims(p.payload, options) : Err("invalid jwt signature")
      }
    }
  }
}

fn verify_parts(p: JwtParts, secret: bytes, options: JwtOptions) Result<JwtClaims, string> {
  return match (header_alg(p.header)) {
    Throw(e) => Err("invalid jwt header"),
    Ok(alg) => alg == "HS256" ? verify_signature(p, secret, options) : Err("unsupported jwt alg")
  }
}

export fn verify(token: string, secret: bytes, options: JwtOptions = {}) Result<JwtClaims, string> {
  return match (jwt_parts(token)) {
    Err(e) => Err(e),
    Ok(p) => verify_parts(p, secret, options)
  }
}
