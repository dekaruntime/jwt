// Compact JWS on @deka/crypto. HS256 only; alg=none is rejected.
import { hmac, secure_compare } from "crypto"

fn utf8(value: string): bytes {
  let encoded = unsafe { new TextEncoder().encode(value) };
  return match (encoded) {
    Ok(buf) => buf,
    Err(err) => utf8("")
  };
}

fn from_utf8(value: bytes): string {
  let decoded = unsafe { new TextDecoder("utf-8", { fatal: false }).decode(value) };
  return match (decoded) {
    Ok(text) => text,
    Err(err) => ""
  };
}

fn b64url_encode(data: bytes): string {
  let r = unsafe {
    var alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    var s = "";
    var i = 0;
    var n = data.byteLength;
    for (i = 0; i < n; i += 3) {
      var b0 = data[i];
      var b1 = i + 1 < n ? data[i + 1] : 0;
      var b2 = i + 2 < n ? data[i + 2] : 0;
      var triple = (b0 << 16) + (b1 << 8) + b2;
      s += alphabet[(triple >> 18) & 63];
      s += alphabet[(triple >> 12) & 63];
      s += i + 1 < n ? alphabet[(triple >> 6) & 63] : "=";
      s += i + 2 < n ? alphabet[triple & 63] : "=";
    }
    return s.replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/g, "");
  };
  return match (r) {
    Ok(v) => v,
    Err(e) => ""
  };
}

fn b64url_decode(value: string): bytes {
  let r = unsafe {
    var alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    var s = String(value).replace(/-/g, "+").replace(/_/g, "/");
    while (s.length % 4 !== 0) s += "=";
    var clean = s.replace(/=+$/, "");
    var n = clean.length;
    var out = [];
    var i = 0;
    for (i = 0; i < n; i += 4) {
      var c0 = alphabet.indexOf(clean[i]);
      var c1 = alphabet.indexOf(clean[i + 1]);
      var c2 = i + 2 < n ? alphabet.indexOf(clean[i + 2]) : 0;
      var c3 = i + 3 < n ? alphabet.indexOf(clean[i + 3]) : 0;
      var triple = (c0 << 18) + (c1 << 12) + (c2 << 6) + c3;
      out.push((triple >> 16) & 255);
      if (i + 2 < n) out.push((triple >> 8) & 255);
      if (i + 3 < n) out.push(triple & 255);
    }
    return new Uint8Array(out);
  };
  return match (r) {
    Ok(buf) => buf,
    Err(err) => utf8("")
  };
}

fn header_json(alg: string): string {
  if (alg == "HS256") {
    return "{\"alg\":\"HS256\",\"typ\":\"JWT\"}"
  }
  return ""
}

fn option_alg<T>(options: T): string {
  let r = unsafe { String(options && options.alg ? options.alg : "HS256").toUpperCase() };
  return match (r) {
    Ok(v) => v,
    Err(e) => "HS256"
  };
}

fn claims_json<T, U>(payload: T, options: U): string {
  let r = unsafe {
    var claims = Object.assign({}, payload);
    var now = Math.floor(Date.now() / 1000);
    if (options && options.iss != null) claims.iss = options.iss;
    if (options && options.aud != null) claims.aud = options.aud;
    if (options && options.sub != null) claims.sub = options.sub;
    if (claims.iat == null) claims.iat = now;
    if (options && options.exp_in != null) claims.exp = now + Number(options.exp_in);
    if (options && options.exp != null) claims.exp = Number(options.exp);
    return JSON.stringify(claims);
  };
  return match (r) {
    Ok(v) => v,
    Err(e) => ""
  };
}

fn jwt_parts(token: string) {
  return unsafe {
    var p = String(token).split(".");
    if (p.length !== 3) throw new Error("invalid jwt format");
    return { header: p[0], payload: p[1], signature: p[2], input: p[0] + "." + p[1] };
  };
}

fn header_alg(header_b64: string): string {
  const json = from_utf8(b64url_decode(header_b64));
  let r = unsafe { String(JSON.parse(json).alg || "") };
  return match (r) {
    Ok(v) => v,
    Err(e) => ""
  };
}

fn require_hs256(alg: string) {
  if (alg == "HS256") {
    return Ok(true)
  }
  return Err("unsupported jwt alg")
}

fn require_signature(eq: boolean) {
  if (eq) {
    return Ok(true)
  }
  return Err("invalid jwt signature")
}

fn parse_claims(payload_b64: string) {
  const json = from_utf8(b64url_decode(payload_b64));
  return unsafe { JSON.parse(json) };
}

fn validate_claims<T, U>(claims: T, options: U) {
  return unsafe {
    var now = Math.floor(Date.now() / 1000);
    var leeway = options && options.leeway != null ? Number(options.leeway) : 0;
    if (claims.iat != null && Number(claims.iat) - leeway > now) {
      throw new Error("jwt issued in future");
    }
    if (claims.exp != null && Number(claims.exp) + leeway < now) {
      throw new Error("jwt expired");
    }
    if (claims.nbf != null && Number(claims.nbf) - leeway > now) {
      throw new Error("jwt not active yet");
    }
    if (options && options.iss != null && String(claims.iss || "") !== String(options.iss)) {
      throw new Error("jwt issuer mismatch");
    }
    if (options && options.aud != null && String(claims.aud || "") !== String(options.aud)) {
      throw new Error("jwt audience mismatch");
    }
    return true;
  };
}

export fn sign<T, U>(payload: T, secret: bytes, options: U = {}) {
  const alg = option_alg(options);
  const header = header_json(alg);
  if (header == "") {
    return Err("unsupported jwt alg")
  }
  const payload_json = claims_json(payload, options);
  if (payload_json == "") {
    return Err("failed to encode jwt payload")
  }
  const input = b64url_encode(utf8(header)) + "." + b64url_encode(utf8(payload_json));
  return match (hmac("sha256", secret, utf8(input))) {
    Ok(sig) => Ok(input + "." + b64url_encode(sig)),
    Err(e) => Err(e)
  }
}

export fn verify<T>(token: string, secret: bytes, options: T = {}) {
  return match (jwt_parts(token)) {
    Err(e) => Err("invalid jwt format"),
    Ok(p) => match (require_hs256(header_alg(p.header))) {
      Err(e) => Err(e),
      Ok(_) => match (hmac("sha256", secret, utf8(p.input))) {
        Err(e) => Err(e),
        Ok(expected) => match (secure_compare(expected, b64url_decode(p.signature))) {
          Err(e) => Err(e),
          Ok(eq) => match (require_signature(eq)) {
            Err(e) => Err(e),
            Ok(_) => match (parse_claims(p.payload)) {
              Err(e) => Err("invalid jwt payload"),
              Ok(claims) => match (validate_claims(claims, options)) {
                Err(e) => Err(e),
                Ok(_) => Ok(claims)
              }
            }
          }
        }
      }
    }
  }
}
